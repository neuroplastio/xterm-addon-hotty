{
  "name": "xterm-addon-hotty",
  "version": "0.0.1",
  "private": true,
  "description": "HOTTY (HTML Over The TTY) for xterm.js: surfaces rendered by the browser, each in a sandboxed iframe",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run build && npm run test:unit && npm run test:e2e"
  },
  "peerDependencies": {
    "@xterm/xterm": "^6.0.0 || ^6.1.0-0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.3",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/xterm": "6.1.0-beta.304",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/neuroplastio/xterm-addon-hotty.git"
  },
  "keywords": [
    "xterm.js",
    "xterm",
    "addon",
    "hotty",
    "terminal",
    "html"
  ]
}
